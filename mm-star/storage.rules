rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} { allow read: if true; allow write: if false; }
    match /categories/{allPaths=**} { allow read: if true; allow write: if false; }
    match /branding/{allPaths=**} { allow read: if true; allow write: if false; }
    match /invoices/{allPaths=**} { allow read, write: if false; }
  }
}
